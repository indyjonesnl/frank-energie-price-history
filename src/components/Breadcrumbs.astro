---
interface Crumb { label: string; href?: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumbs" class="text-sm text-slate-500 my-3">
  <ol class="flex flex-wrap items-center gap-x-1 gap-y-1">
    {items.map((c, i) => (
      <li class="flex items-center gap-x-1">
        {c.href ? <a href={c.href} class="inline-block py-1 text-blue-600 hover:underline">{c.label}</a> : <span class="text-slate-900 font-medium">{c.label}</span>}
        {i < items.length - 1 ? <span aria-hidden="true" class="text-slate-300">/</span> : null}
      </li>
    ))}
  </ol>
</nav>
