---
import '../styles/global.css';
import { canonical, buildOg, withBase, isActive } from '@lib/seo';
import { availableYears } from '@lib/data-loader';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>;
  wide?: boolean;
}
const { title, description, path, jsonLd, wide } = Astro.props;
const og = buildOg({ title, description, path });
const url = canonical(path);
const years = availableYears();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('fe-show-warnings') === '0') {
            document.documentElement.classList.add('hide-warnings');
          }
        } catch (e) { /* no-op */ }
      })();
    </script>
    <link rel="canonical" href={url} />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:url" content={og.url} />
    <meta property="og:type" content={og.type} />
    <meta property="og:site_name" content={og.siteName} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <header class="border-b border-slate-200">
      <div class="mx-auto max-w-5xl px-4 py-4 flex flex-wrap items-baseline gap-x-4 sm:gap-x-6 gap-y-2">
        <a href={withBase('/')} class="text-base font-semibold tracking-tight text-slate-900 hover:text-blue-600">Frank Energie Price History</a>
        {isActive(path, '/today/')
          ? <span class="text-sm text-slate-900 font-medium">Today</span>
          : <a href={withBase('/today/')} class="inline-block py-1 text-sm text-blue-600 hover:underline">Today</a>}
        {years.length > 0 && (
          <nav aria-label="Years" class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
            <span class="text-slate-500">Years:</span>
            {years.map((y) => (
              isActive(path, `/year/${y}/`)
                ? <span class="text-slate-900 font-medium">{y}</span>
                : <a href={withBase(`/year/${y}/`)} class="inline-block py-1 text-blue-600 hover:underline">{y}</a>
            ))}
          </nav>
        )}
        <label class="inline-flex items-center gap-x-2 text-sm text-slate-600 select-none">
          <input id="warning-toggle" type="checkbox" class="accent-orange-500" />
          Show <span aria-hidden="true">⚠</span><span class="sr-only">negative-price</span> warnings
        </label>
      </div>
    </header>
    <main class={`mx-auto px-4 py-8 ${wide ? 'max-w-[1600px]' : 'max-w-5xl'}`}>
      <slot />
    </main>
    <footer class="mt-12 border-t border-slate-200">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-slate-500">
        <p>
          Data via Frank Energie's public GraphQL API. Site not affiliated with Frank Energie.
          <a href={withBase('/data-source/')} class="text-blue-600 hover:underline">Data source</a>
        </p>
      </div>
    </footer>
    <script src={withBase('/tooltip.js')} defer></script>
    <script is:inline>
      (function () {
        var KEY = 'fe-show-warnings';
        var cb = document.getElementById('warning-toggle');
        if (!cb) return;
        var get = function () { try { return localStorage.getItem(KEY) !== '0'; } catch (_) { return true; } };
        var apply = function () { document.documentElement.classList.toggle('hide-warnings', !get()); };
        cb.checked = get();
        apply();
        cb.addEventListener('change', function () {
          try { localStorage.setItem(KEY, cb.checked ? '1' : '0'); } catch (_) {}
          apply();
        });
      })();
    </script>
  </body>
</html>
