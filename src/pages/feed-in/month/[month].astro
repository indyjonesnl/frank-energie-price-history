---
import Layout from '@components/Layout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SvgChart from '@components/SvgChart.astro';
import { loadAllDays } from '@lib/data-loader';
import { avg } from '@lib/stats';
import { monthKey, monthRange } from '@lib/periods';
import { humanDate, humanMonth } from '@lib/format';
import { withBase, isActive } from '@lib/seo';

export async function getStaticPaths() {
  const days = loadAllDays();
  const months = new Map<string, typeof days>();
  for (const d of days) {
    const k = monthKey(new Date(`${d.date}T12:00:00Z`));
    months.set(k, [...(months.get(k) ?? []), d]);
  }
  return [...months.entries()].map(([month, daysInMonth]) => ({ params: { month }, props: { month, days: daysInMonth } }));
}

const { month, days } = Astro.props;
const currentPath = `/feed-in/month/${month}/`;
const range = monthRange(month);
const monthYear = humanMonth(month);
const yk = month.slice(0, 4);
const crumbs = [
  { label: 'Home', href: withBase('/') },
  { label: 'Electricity (feed-in)', href: withBase('/feed-in/') },
  { label: yk, href: withBase(`/feed-in/year/${yk}/`) },
  { label: monthYear }
];
const negFeedHours = (d: typeof days[number]) =>
  d.electricity.hours.filter(h => h.all_in_feed_in !== null && h.all_in_feed_in < 0).length;
const negFeedDaysTotal = days.filter(d => negFeedHours(d) > 0).length;
const negFeedHoursTotal = days.reduce((n, d) => n + negFeedHours(d), 0);
const points = days.map(d => {
  const wc = negFeedHours(d);
  return {
    label: d.date.slice(8),
    value: avg(d.electricity.hours.map(h => h.all_in_feed_in ?? 0)),
    href: withBase(`/feed-in/day/${d.date}/`),
    warning: wc > 0,
    warningCount: wc > 0 ? wc : undefined,
  };
});
const title = `Electricity feed-in prices in ${monthYear} — Frank Energie`;
const desc = `Daily-average Frank Energie electricity feed-in prices for ${monthYear}.`;
---
<Layout title={title} description={desc} path={`/feed-in/month/${month}/`}>
  <Breadcrumbs items={crumbs} />
  <h1>Electricity (feed-in) in {monthYear}</h1>
  {negFeedHoursTotal > 0 && (
    <p class="negative-warning text-sm text-orange-600 -mt-2 mb-2">
      Negative prices: {negFeedDaysTotal} {negFeedDaysTotal === 1 ? 'day' : 'days'}, {negFeedHoursTotal} {negFeedHoursTotal === 1 ? 'hour' : 'hours'} total
    </p>
  )}
  <p>{humanDate(range.from)} – {humanDate(range.to)}</p>
  <SvgChart title="Daily average feed-in" points={points} unit="EUR/kWh" xAxisLabel="Day of month" />
  <section>
    <h2>Days</h2>
    <ul class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
      {days.map((d) => {
        const targetPath = `/feed-in/day/${d.date}/`;
        return (
          <li>
            {isActive(currentPath, targetPath)
              ? <span class="text-slate-900 font-medium">{d.date.slice(8)}</span>
              : <a href={withBase(targetPath)} class="inline-block py-1 text-blue-600 hover:underline">{d.date.slice(8)}</a>}
          </li>
        );
      })}
    </ul>
  </section>
</Layout>
